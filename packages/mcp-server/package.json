{
  "name": "ai-admin-api-mcp",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "ai-admin-api-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist",
    "!dist/**/*.test.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:stdio": "tsx src/cli.ts --stdio",
    "start:http": "tsx src/cli.ts --http --port 8787"
  },
  "dependencies": {
    "@ai-admin-api-mcp/core": "workspace:*",
    "@ai-admin-api-mcp/provider-anthropic": "workspace:*",
    "@ai-admin-api-mcp/provider-openai": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  }
}
