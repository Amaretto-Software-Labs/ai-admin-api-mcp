{
  "name": "@amaretto-software-labs/ai-admin-api-mcp",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amaretto-Software-Labs/ai-admin-api-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Amaretto-Software-Labs/ai-admin-api-mcp/issues"
  },
  "homepage": "https://github.com/Amaretto-Software-Labs/ai-admin-api-mcp#readme",
  "bin": {
    "ai-admin-api-mcp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "docs",
    "dist",
    "!dist/**/*.test.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live:openai": "vitest run src/providers/openai/live.test.ts",
    "test:live:anthropic": "vitest run src/providers/anthropic/live.test.ts",
    "test:live:google-billing": "echo \"Google Cloud Billing provider is planned; see docs/google-cloud-billing.md\"",
    "start:stdio": "tsx src/cli.ts --stdio",
    "start:http": "tsx src/cli.ts --http --port 8787",
    "start:https": "tsx src/cli.ts --https --port 8787"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
